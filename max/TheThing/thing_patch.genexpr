// generated by thing.js -- do not edit

t_osc(f, shape, tune, pw) {
	History ph(0);
	nph = wrap(ph + f * pow(2, tune / 12) / samplerate, 0, 1);
	ph = nph;
	s = sin(twopi * nph);
	t = 4 * abs(nph - 0.5) - 1;
	w = 2 * nph - 1;
	q = nph < pw ? 1 : -1;
	return shape < 0.5 ? s : (shape < 1.5 ? t : (shape < 2.5 ? w : q));
}

t_svf(x, fc, res, mode, key, track) {
	History lp(0);
	History bp(0);
	fr = clamp(fc * pow(key / 261.63, track), 10, samplerate * 0.15);
	f = 2 * sin(pi * fr / samplerate);
	d = mix(2, 0.05, clamp(res, 0, 1));
	hp = x - lp - d * bp;
	nbp = bp + f * hp;
	nlp = lp + f * nbp;
	bp = nbp;
	lp = nlp;
	return mode < 0.5 ? nlp : (mode < 1.5 ? nbp : hp);
}

t_env(gate, a, d, s, r) {
	History lvl(0);
	History stg(0);
	History gp(0);
	on = gate > 0.5;
	if (on && gp < 0.5) { stg = 1; }
	if (!on) { stg = 0; }
	gp = on;
	st = stg;
	l = lvl;
	if (st == 1) {
		l = lvl + 1 / (max(a, 0.0005) * samplerate);
		if (l >= 1) { l = 1; stg = 2; }
	}
	if (st == 2) {
		l = lvl - (1 - s) / (max(d, 0.0005) * samplerate);
		if (l <= s) { l = s; stg = 3; }
	}
	if (st == 3) { l = s; }
	if (st == 0) { l = lvl * exp(-5 / (max(r, 0.001) * samplerate)); }
	lvl = l;
	return l;
}

t_rd(S, base, p) {
	i0 = floor(p);
	fr = p - i0;
	return mix(peek(S, base + i0), peek(S, base + i0 + 1), fr);
}

// sample map lives in the parameter buffer: slot 1024 + idx * 4 = start frame, +1 = length, +2 = sample rate
// loop crossfade (forward loops): the last xl frames before B are blended with the frames after A,
// and playback wraps to A + xl, so the join is continuous without needing audio before A
t_smp(P, S, gate, freq, idx, vol, off, loop, la, lb, lty, xf, root) {
	History pos(0);
	History dir(1);
	History gp(0);
	History run(0);
	i = clamp(floor(idx), 0, 63);
	base = peek(P, 1024 + i * 4);
	len = peek(P, 1024 + i * 4 + 1);
	rate = freq / (440 * pow(2, (root - 69) / 12)) * peek(P, 1024 + i * 4 + 2) / samplerate;
	on = gate > 0.5;
	trig = on && gp < 0.5;
	gp = on;
	a = la * len;
	b = min(max(lb * len, a + 4), len - 2);
	xl = min(xf * (b - a), (b - a) * 0.5);
	np = pos + dir * rate;
	nd = dir;
	nr = run;
	if (trig) { np = off * len; nd = 1; nr = 1; }
	if (loop > 0.5 && nr > 0.5) {
		if (lty < 0.5) {
			if (np >= b) { np = a + xl + (np - b); }
		} else {
			if (np >= b) { np = 2 * b - np; nd = -1; }
			if (np <= a && nd < 0) { np = 2 * a - np; nd = 1; }
		}
	}
	if (loop < 0.5 && np >= len - 1) { nr = 0; }
	if (len < 4) { nr = 0; }
	x = t_rd(S, base, clamp(np, 0, max(len - 2, 0)));
	if (loop > 0.5 && lty < 0.5 && xl > 1 && np >= b - xl && np < b) {
		x = mix(x, t_rd(S, base, a + np - (b - xl)), (np - (b - xl)) / xl);
	}
	pos = np;
	dir = nd;
	run = nr;
	return nr > 0.5 ? x * vol : 0;
}


t_alloc(pitch, vel, trig) {
	History ck(0);
	History bz0(0);
	History ag0(0);
	History pt0(0);
	History bz1(0);
	History ag1(0);
	History pt1(0);
	History bz2(0);
	History ag2(0);
	History pt2(0);
	History bz3(0);
	History ag3(0);
	History pt3(0);
	History bz4(0);
	History ag4(0);
	History pt4(0);
	History bz5(0);
	History ag5(0);
	History pt5(0);
	History bz6(0);
	History ag6(0);
	History pt6(0);
	History bz7(0);
	History ag7(0);
	History pt7(0);
	ev = 0;
	if (trig > 0.5) { ev = vel > 0 ? 1 : (vel < 0 ? 3 : 2); }
	nck = ck + (ev == 1 ? 1 : 0);
	ck = nck;
	best = ag0 + bz0 * 1000000000;
	bi = 0;
	sc = ag1 + bz1 * 1000000000;
	if (sc < best) { best = sc; bi = 1; }
	sc = ag2 + bz2 * 1000000000;
	if (sc < best) { best = sc; bi = 2; }
	sc = ag3 + bz3 * 1000000000;
	if (sc < best) { best = sc; bi = 3; }
	sc = ag4 + bz4 * 1000000000;
	if (sc < best) { best = sc; bi = 4; }
	sc = ag5 + bz5 * 1000000000;
	if (sc < best) { best = sc; bi = 5; }
	sc = ag6 + bz6 * 1000000000;
	if (sc < best) { best = sc; bi = 6; }
	sc = ag7 + bz7 * 1000000000;
	if (sc < best) { best = sc; bi = 7; }
	tv = ev == 1 ? bi : -1;
	if (ev == 1 && bi == 0) { bz0 = 1; ag0 = nck; pt0 = pitch; }
	if (ev == 3 || (ev == 2 && bz0 > 0.5 && pt0 == pitch)) { bz0 = 0; }
	if (ev == 1 && bi == 1) { bz1 = 1; ag1 = nck; pt1 = pitch; }
	if (ev == 3 || (ev == 2 && bz1 > 0.5 && pt1 == pitch)) { bz1 = 0; }
	if (ev == 1 && bi == 2) { bz2 = 1; ag2 = nck; pt2 = pitch; }
	if (ev == 3 || (ev == 2 && bz2 > 0.5 && pt2 == pitch)) { bz2 = 0; }
	if (ev == 1 && bi == 3) { bz3 = 1; ag3 = nck; pt3 = pitch; }
	if (ev == 3 || (ev == 2 && bz3 > 0.5 && pt3 == pitch)) { bz3 = 0; }
	if (ev == 1 && bi == 4) { bz4 = 1; ag4 = nck; pt4 = pitch; }
	if (ev == 3 || (ev == 2 && bz4 > 0.5 && pt4 == pitch)) { bz4 = 0; }
	if (ev == 1 && bi == 5) { bz5 = 1; ag5 = nck; pt5 = pitch; }
	if (ev == 3 || (ev == 2 && bz5 > 0.5 && pt5 == pitch)) { bz5 = 0; }
	if (ev == 1 && bi == 6) { bz6 = 1; ag6 = nck; pt6 = pitch; }
	if (ev == 3 || (ev == 2 && bz6 > 0.5 && pt6 == pitch)) { bz6 = 0; }
	if (ev == 1 && bi == 7) { bz7 = 1; ag7 = nck; pt7 = pitch; }
	if (ev == 3 || (ev == 2 && bz7 > 0.5 && pt7 == pitch)) { bz7 = 0; }
	return tv, ev;
}

t_vslot(i, tv, ev, pitch, vel) {
	History g(0);
	History p(0);
	History f(0);
	History v(0);
	non = ev == 1 && tv == i;
	noff = ev == 3 || (ev == 2 && g > 0.5 && p == pitch);
	og, ng, np, nf, nv = g, g, p, f, v;
	if (non) {
		np, nf, nv, ng = pitch, 440 * pow(2, (pitch - 69) / 12), vel * 0.007874015748031496, 1;
		og = g > 0.5 ? 0 : 1;
	}
	if (noff) { og, ng = 0, 0; }
	g, p, f, v = ng, np, nf, nv;
	return nf, og, nv;
}

thing_patch(P, S, vpitch, vvel, vtrig) {
	voice_tv, voice_ev = t_alloc(vpitch, vvel, vtrig);
	// n1 note
	n1_freq_0, n1_gate_0, n1_vel_0 = t_vslot(0, voice_tv, voice_ev, vpitch, vvel);
	n1_freq_1, n1_gate_1, n1_vel_1 = t_vslot(1, voice_tv, voice_ev, vpitch, vvel);
	n1_freq_2, n1_gate_2, n1_vel_2 = t_vslot(2, voice_tv, voice_ev, vpitch, vvel);
	n1_freq_3, n1_gate_3, n1_vel_3 = t_vslot(3, voice_tv, voice_ev, vpitch, vvel);
	n1_freq_4, n1_gate_4, n1_vel_4 = t_vslot(4, voice_tv, voice_ev, vpitch, vvel);
	n1_freq_5, n1_gate_5, n1_vel_5 = t_vslot(5, voice_tv, voice_ev, vpitch, vvel);
	n1_freq_6, n1_gate_6, n1_vel_6 = t_vslot(6, voice_tv, voice_ev, vpitch, vvel);
	n1_freq_7, n1_gate_7, n1_vel_7 = t_vslot(7, voice_tv, voice_ev, vpitch, vvel);
	// n2 osc
	n2_k_wave = peek(P, 32);
	n2_k_tune = peek(P, 33);
	n2_k_pw = peek(P, 34);
	n2_out_0 = t_osc(n1_freq_0, n2_k_wave, n2_k_tune, n2_k_pw);
	n2_out_1 = t_osc(n1_freq_1, n2_k_wave, n2_k_tune, n2_k_pw);
	n2_out_2 = t_osc(n1_freq_2, n2_k_wave, n2_k_tune, n2_k_pw);
	n2_out_3 = t_osc(n1_freq_3, n2_k_wave, n2_k_tune, n2_k_pw);
	n2_out_4 = t_osc(n1_freq_4, n2_k_wave, n2_k_tune, n2_k_pw);
	n2_out_5 = t_osc(n1_freq_5, n2_k_wave, n2_k_tune, n2_k_pw);
	n2_out_6 = t_osc(n1_freq_6, n2_k_wave, n2_k_tune, n2_k_pw);
	n2_out_7 = t_osc(n1_freq_7, n2_k_wave, n2_k_tune, n2_k_pw);
	// n6 lfo
	n6_k_rate = peek(P, 56);
	n6_k_shape = peek(P, 57);
	n6_out = t_osc(n6_k_rate, n6_k_shape, 0, 0.5);
	// n3 filter
	n3_k_cutoff = peek(P, 38);
	n3_a_cutoff = peek(P, 42);
	n3_k_res = peek(P, 39);
	n3_k_mode = peek(P, 40);
	n3_k_track = peek(P, 41);
	n3_out_0 = t_svf(n2_out_0, (n3_k_cutoff * pow(2, n6_out * n3_a_cutoff)), n3_k_res, n3_k_mode, n1_freq_0, n3_k_track);
	n3_out_1 = t_svf(n2_out_1, (n3_k_cutoff * pow(2, n6_out * n3_a_cutoff)), n3_k_res, n3_k_mode, n1_freq_1, n3_k_track);
	n3_out_2 = t_svf(n2_out_2, (n3_k_cutoff * pow(2, n6_out * n3_a_cutoff)), n3_k_res, n3_k_mode, n1_freq_2, n3_k_track);
	n3_out_3 = t_svf(n2_out_3, (n3_k_cutoff * pow(2, n6_out * n3_a_cutoff)), n3_k_res, n3_k_mode, n1_freq_3, n3_k_track);
	n3_out_4 = t_svf(n2_out_4, (n3_k_cutoff * pow(2, n6_out * n3_a_cutoff)), n3_k_res, n3_k_mode, n1_freq_4, n3_k_track);
	n3_out_5 = t_svf(n2_out_5, (n3_k_cutoff * pow(2, n6_out * n3_a_cutoff)), n3_k_res, n3_k_mode, n1_freq_5, n3_k_track);
	n3_out_6 = t_svf(n2_out_6, (n3_k_cutoff * pow(2, n6_out * n3_a_cutoff)), n3_k_res, n3_k_mode, n1_freq_6, n3_k_track);
	n3_out_7 = t_svf(n2_out_7, (n3_k_cutoff * pow(2, n6_out * n3_a_cutoff)), n3_k_res, n3_k_mode, n1_freq_7, n3_k_track);
	// n4 env
	n4_k_a = peek(P, 46);
	n4_k_d = peek(P, 47);
	n4_k_s = peek(P, 48);
	n4_k_r = peek(P, 49);
	n4_out_0 = t_env(n1_gate_0, n4_k_a, n4_k_d, n4_k_s, n4_k_r);
	n4_out_1 = t_env(n1_gate_1, n4_k_a, n4_k_d, n4_k_s, n4_k_r);
	n4_out_2 = t_env(n1_gate_2, n4_k_a, n4_k_d, n4_k_s, n4_k_r);
	n4_out_3 = t_env(n1_gate_3, n4_k_a, n4_k_d, n4_k_s, n4_k_r);
	n4_out_4 = t_env(n1_gate_4, n4_k_a, n4_k_d, n4_k_s, n4_k_r);
	n4_out_5 = t_env(n1_gate_5, n4_k_a, n4_k_d, n4_k_s, n4_k_r);
	n4_out_6 = t_env(n1_gate_6, n4_k_a, n4_k_d, n4_k_s, n4_k_r);
	n4_out_7 = t_env(n1_gate_7, n4_k_a, n4_k_d, n4_k_s, n4_k_r);
	// n5 vca
	n5_k_gain = peek(P, 54);
	n5_out_0 = n3_out_0 * n4_out_0 * n1_vel_0 * n5_k_gain;
	n5_out_1 = n3_out_1 * n4_out_1 * n1_vel_1 * n5_k_gain;
	n5_out_2 = n3_out_2 * n4_out_2 * n1_vel_2 * n5_k_gain;
	n5_out_3 = n3_out_3 * n4_out_3 * n1_vel_3 * n5_k_gain;
	n5_out_4 = n3_out_4 * n4_out_4 * n1_vel_4 * n5_k_gain;
	n5_out_5 = n3_out_5 * n4_out_5 * n1_vel_5 * n5_k_gain;
	n5_out_6 = n3_out_6 * n4_out_6 * n1_vel_6 * n5_k_gain;
	n5_out_7 = n3_out_7 * n4_out_7 * n1_vel_7 * n5_k_gain;
	// n7 out
	n7_k_level = peek(P, 60);
	mixL = n5_out_0 * n7_k_level + n5_out_1 * n7_k_level + n5_out_2 * n7_k_level + n5_out_3 * n7_k_level + n5_out_4 * n7_k_level + n5_out_5 * n7_k_level + n5_out_6 * n7_k_level + n5_out_7 * n7_k_level;
	mixR = n5_out_0 * n7_k_level + n5_out_1 * n7_k_level + n5_out_2 * n7_k_level + n5_out_3 * n7_k_level + n5_out_4 * n7_k_level + n5_out_5 * n7_k_level + n5_out_6 * n7_k_level + n5_out_7 * n7_k_level;
	return mixL, mixR;
}
