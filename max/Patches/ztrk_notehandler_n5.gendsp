NoteChannel(pTick, nTrig, idx, buf, counter, running, cur_note, v, lookaheadMs) {
    pTick      = floor(pTick);
    loop_len   = dim(buf);
    pTick_next = (pTick + 1) - floor((pTick + 1) / loop_len) * loop_len;

    note      = peek(buf, pTick, idx, 0, channels=1);
    velocity  = peek(buf, pTick, idx + 1, 0, channels=1);
    duration_raw = peek(buf, pTick, idx + 2, 0, channels=1);
    next_note = peek(buf, pTick_next, idx, 0, channels=1);

    durMin = 10.0;
    durMax = 4000.0;
    duration = durMin * pow(durMax / durMin, duration_raw / 255.0);

    // is_noteoff = (note == 0.5 || note == 0.75);
    is_noteoff = (note > -0.9 && note < -0.3);
    lookaheadSamples = lookaheadMs * samplerate / 1000.0;

    if (nTrig == 1.0) {
        if (note > 0.0 && !is_noteoff) {
            cur_note = round(note * 127.0);
            v = round(velocity * 255 / 2);
            running = duration * samplerate / 1000.0;
        } else if (is_noteoff) {
            running = 0.0;
        }
    }

    if (next_note > 0.0 && !(next_note == 0.5 || next_note == 0.75) && running > 0.0 && running <= lookaheadSamples) {
        running = 0.0;
    }

    if (running > 0.0) {
        running = running - 1.0;
    } else {
        cur_note = 0.0;
        v = 0.0;
    }

    return running > 0.0 ? 1.0 : 0.0, cur_note, v, counter, running, cur_note, v;
}

Buffer buf();
Param MainAmp(1.0, min=0.0, max=1.0);
Param lookaheadMs(5.0, min=0.0, max=100.0);

History c1(0), r1(0), n1(0), v1(0);
History c2(0), r2(0), n2(0), v2(0);
History c3(0), r3(0), n3(0), v3(0);
History c4(0), r4(0), n4(0), v4(0);
History c5(0), r5(0), n5(0), v5(0);

trig = in1;
tick = in2;

out1, out6, out11, c1, r1, n1, v1     = NoteChannel(tick, trig, 0,  buf, c1, r1, n1, v1, lookaheadMs);
out2, out7, out12, c2, r2, n2, v2     = NoteChannel(tick, trig, 4,  buf, c2, r2, n2, v2, lookaheadMs);
out3, out8, out13, c3, r3, n3, v3     = NoteChannel(tick, trig, 8,  buf, c3, r3, n3, v3, lookaheadMs);
out4, out9, out14, c4, r4, n4, v4     = NoteChannel(tick, trig, 12, buf, c4, r4, n4, v4, lookaheadMs);
out5, out10, out15, c5, r5, n5, v5    = NoteChannel(tick, trig, 16, buf, c5, r5, n5, v5, lookaheadMs);