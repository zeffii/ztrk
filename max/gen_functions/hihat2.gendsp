                "box": {
                    "code": "voice(exciter, delaymem, fb) {\r\n  y = peek(delaymem, 0);\r\n  poke(delaymem, exciter + y * fb, 0);\r\n  return y;\r\n}\r\n\r\nHistory env_amp(0), trig_prev(0);\r\nData delaymem0(4096);\r\n\r\ntrig = in1 > 0.5 && trig_prev <= 0.5;\r\ntrig_prev = in1;\r\n\r\nenv_coeff = pow(0.001, 1 / (0.3 * samplerate));\r\nenv_amp = trig ? 1 : env_amp * env_coeff;\r\n\r\nexciter = (noise() * 2 - 1) * env_amp;\r\n\r\ny = voice(exciter, delaymem0, 0.9);\r\n\r\nout1 = y;\r\nout2 = y;",
