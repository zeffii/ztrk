/*
wavetable synth mk2  – rewritten with safer History handling + debug
*/

// ---------- function (must come before everything) ----------
adsr(env, state, gate, atk_samps, dec_samps, sus, rel_samps) {
    // note-on / note-off state machine
    if (gate && state == 0) {                   state = 1; }  // → attack
    else if (!gate && state > 0 && state < 4) { state = 4; }  // → release

    if (state == 1) {                       // attack
        env = env + 1 / atk_samps;
        if (env >= 1) env, state = 1, 2;
    } else if (state == 2) {                // decay
        env = env - (1 - sus) / dec_samps;
        if (env <= sus) env, state = sus, 3;
    } else if (state == 3) {                // sustain
        env = sus;
    } else if (state == 4) {                // release
        env = env - env / rel_samps;
        if (env < 0.0001) env, state = 0, 0;
    }

    return env, state;
}

// ---------- declarations ----------
Buffer wt("synth_wt");

Param A(0.01), D(0.2), S(0.7), R(0.3);
Param FA(0.01), FD(0.3), FS(0.4), FR(0.4);
Param cutoff(1200), res(0.3), fenv_amt(0.6), gain(0.4);

History amp_env(0), amp_state(0);       // 0=idle 1=atk 2=dec 3=sus 4=rel
History fenv(0),    fstate(0);
History phase(0);
History low(0), band(0);

// ---------- main code ----------
freq = max(in1, 1);
gate = in2 > 0.5;                       // change to gate = 1; for forced always-on test
// gate = 1;

// seconds → samples (never divide by zero)
sr         = samplerate;
atk_samps  = max(A  * sr, 1);
dec_samps  = max(D  * sr, 1);
rel_samps  = max(R  * sr, 1);
fatk_samps = max(FA * sr, 1);
fdec_samps = max(FD * sr, 1);
frel_samps = max(FR * sr, 1);

// ---- amplitude envelope (safe History write-back) ----
amp = amp_env;
st  = amp_state;
amp, st = adsr(amp, st, gate, atk_samps, dec_samps, S, rel_samps);
amp_env   = amp;
amp_state = st;

// ---- filter envelope (same pattern) ----
fe = fenv;
fst = fstate;
fe, fst = adsr(fe, fst, gate, fatk_samps, fdec_samps, FS, frel_samps);
fenv   = fe;
fstate = fst;

// ---------- wavetable oscillator ----------
phase = wrap(phase + freq / sr, 0, 1);
osc = sample(wt, phase, interp="linear");

// ---------- resonant low-pass (SVF-style) ----------
mod_cut = cutoff * (1 + fenv * fenv_amt * 8);
mod_cut = clip(mod_cut, 20, sr * 0.45);

f = 2 * sin(pi * mod_cut / sr);
q = max(1 - res, 0.05);

high = osc - low - q * band;
band = band + f * high;
low  = low  + f * band;
filt = tanh(low * 1.2);                 // soft saturation

// ---------- outputs ----------
out1 = filt * amp_env * gain;           // main audio
out2 = amp_env;                         // amplitude envelope (visual / sidechain)
out3 = fenv;                            // filter envelope (visual)
out4 = osc * amp_env * gain;            // dry (filter bypass) – useful for debugging