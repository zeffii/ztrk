            },
            {
                "box": {
                    "code": "// paste into a gen~ codebox (2 inlets, 6 outlets)\r\n// also create a [buffer~ patchparams 1 512] in the patcher and put 0.5 in sample 0\r\n\r\nrequire(\"testlib\");\r\n\r\nData tbl(512);\r\nBuffer pbuf(\"patchparams\");\r\n\r\nif (elapsed < 1) { poke(tbl, 0.25, 7); }\r\n\r\na = onepole(in1, 0.9);\r\nb = onepole(in1, 0.99);\r\nc = readp(tbl, 7);\r\nd = writep(tbl, 3, in2);\r\ng = peek(tbl, 3);\r\nf = readp(pbuf, 0);\r\n\r\nout1, out2, out3, out4, out5, out6 = a, b, c, d, g, f;\nout7 = peek(pbuf, 0);\r\n",
                    "fontface": 0,
                    "fontname": "<Monospaced>",
                    "fontsize": 12.0,
                    "id": "obj-1",
                    "maxclass": "gen.codebox~",
                    "numinlets": 2,
                    "numoutlets": 7,
                    "outlettype": [ "signal", "signal", "signal", "signal", "signal", "signal", "signal" ],
                    "patching_rect": [ 69.0, 210.0, 649.0, 284.0 ]
                }
            },
