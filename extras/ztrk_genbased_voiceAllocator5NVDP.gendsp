// === allocator: finds a free voice, or steals the oldest one, claims it ===
function allocVoiceZ(pitch, vel, durSamps, busyArr, ageArr, remainArr, pitchArr, velArr, nvoices) {
    idx = -1;
    oldestAge = -1;
    oldestIdx = 0;

    for (i = 0; i < nvoices; i += 1) {
        busy = peek(busyArr, i, 0);
        age = peek(ageArr, i, 0);

        if (busy < 0.5 && idx < 0) { idx = i; }  // first free slot found

        if (age > oldestAge) {
            oldestAge = age;
            oldestIdx = i;
        }
    }
    if (idx < 0) { idx = oldestIdx; } // nothing free — steal the oldest

    // claim it immediately, so the *next* lane's scan this same sample sees it as busy
    poke(busyArr, 1, idx, 0);
    poke(ageArr, 0, idx, 0);
    poke(remainArr, durSamps, idx, 0);
    poke(pitchArr, pitch, idx, 0);
    poke(velArr, vel, idx, 0);
    return idx;
}

Param maxVoices(8);   // runtime-adjustable active voice cap

NVOICES = 24;         // compile-time array size (fixed ceiling)
Data voiceBusy(NVOICES);
Data voiceAge(NVOICES);
Data voiceRemain(NVOICES);
Data voicePitch(NVOICES);
Data voiceVel(NVOICES);

// === per-sample body ===

activeVoices = min(maxVoices, NVOICES);

// age every voice by one sample first (so a freshly-claimed voice reads age=0 this sample, not last sample's stale value)
for (i = 0; i < activeVoices; i += 1) {
    a = peek(voiceAge, i, 0);
    poke(voiceAge, a + 1, i, 0);
}

// lane 0..4 processed in fixed order — each call mutates voiceBusy/voiceAge in place,
// so lane 1 already sees lane 0's claim, lane 2 sees lanes 0+1, etc.
if (noteTrig0 > 0.5) {
    allocVoiceZ(pitch0, vel0, dur0, voiceBusy, voiceAge, voiceRemain, voicePitch, voiceVel, activeVoices);
}
if (noteTrig1 > 0.5) {
    allocVoiceZ(pitch1, vel1, dur1, voiceBusy, voiceAge, voiceRemain, voicePitch, voiceVel, activeVoices);
}
// ... same pattern for lanes 2, 3, 4

// finally: decrement remaining duration, free voices whose time is up
for (i = 0; i < activeVoices; i += 1) {
    rem = peek(voiceRemain, i, 0);
    rem = rem - 1;
    poke(voiceRemain, rem, i, 0);
    if (rem <= 0) {
        poke(voiceBusy, 0, i, 0);
    }
}