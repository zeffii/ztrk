                        "boxes": [
                            {
                                "box": {
                                    "code": "History waveformChanged(0);\r\n\r\nwrap = in1;\r\n\r\nfor (i = 0; i < dim(waveform); i += 1){\r\n\r\n    // sparse check waveform differences\r\n    index = (dim(waveform) / 10) * i;\r\n    \r\n    val = peek(waveform, index);\r\n    prevVal = peek(wave, index);\r\n    \r\n    // waveform definitely changed, update data\r\n    if (val != prevVal){ \r\n        waveformChanged = 1;\r\n        break;\r\n    }\r\n}\r\n\r\n// update data\r\nif (wrap && waveformChanged){\r\n\r\n    for (i = 0; i < dim(waveform); i += 1){\r\n        \r\n        val = peek(waveform, i);\r\n        poke(wave, val, i);\r\n    }\r\n    waveformChanged = 0;        \r\n}",
                                    "fontface": 0,
                                    "fontname": "<Monospaced>",
                                    "fontsize": 12.0,
