Buffer WTA();  // reference a buffer in the patcher named WTA
History recording(0);    // persistent state variable
History sample_index(0); // persistent state variable

num_samples = dim(WTA);

// feed a click into in2, and a mono signal into inl
if (in2 == 1){ recording = 1; }
if (sample_index == (num_samples - 1)){ 
    recording = 0;
    sample_index = 0;
}

if (recording) {
    poke(WTA, in1, sample_index);
    sample_index += 1;
}

out1 = in1 + in2;  // not strictly needed.