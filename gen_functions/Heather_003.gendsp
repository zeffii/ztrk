Param Duration(170, min=1.0, max=1200);

History Active(0);
History Elapsed_Samples(0);
History EnvValue(0);

Buffer Anex("Env1");

dur = max(mstosamps(Duration), 2);
theta = 1 / dur;

// TRIGGER
if (in1 > 0) {
    Active = 1;
    Elapsed_Samples = 0;
    EnvValue = 1;
}

// ENVELOPE
if (Active > 0) {
    EnvValue = peek(Anex, theta*Elapsed_Samples, index="phase", interp="cubic");
    if (Elapsed_Samples >= dur - 1) { Active, EnvValue = 0, 0; }
    else                            { Elapsed_Samples += 1;    }
}

out1 = EnvValue;